;====================================================================
; Apex AI Trader - Aggressive Demo Testing Preset (.set)
; Higher trading frequency and wider risk tolerance for demo stress testing
;====================================================================
InpAppWorkingName=Apex AI Trader
InpMagicNumber=100992
InpExecutionMode=2
InpLiveAuthorizationKey=
InpScanSymbolsList=EURUSD,GBPUSD,USDJPY,AUDUSD,USDCAD,USDCHF,NZDUSD,EURJPY,GBPJPY,XAUUSD,BTCUSD

;--- Capital & Hard Risk Preservation
InpMaxRiskPerTradePct=1.50
InpMaxTotalOpenRiskPct=5.00
InpMaxDailyLossPct=4.00
InpMaxWeeklyLossPct=8.00
InpMaxPeakDrawdownPct=10.00
InpMinFreeMarginLevel=180.0
InpMaxSpreadPoints=35
InpMaxSpreadToAtrRatio=0.30
InpMaxSimultaneousTrades=6
InpMaxTradesPerSymbol=2
InpMaxCorrelatedCurrency=3
InpMaxConsecutiveLosses=4
InpCooldownMinutes=45
InpEquityCompounding=true

;--- Stop-Loss & Take-Profit Governance
InpAtrMultiplierSL=1.20
InpAtrMultiplierTP=2.00
InpMinRewardRiskRatio=1.40
InpUseBreakEven=true
InpBreakEvenTriggerR=0.90
InpBreakEvenOffsetPips=1.00
InpUseTrailingStop=true
InpTrailingActivationR=1.20
InpUsePartialProfitTaking=true
InpPartialCloseR=1.10
InpPartialClosePct=40.0
InpMaxHoldingBarsM5=48

;--- Remote Dashboard & AI Service Bridge
InpEnableWebBridge=true
InpServerUrl=http://127.0.0.1:3000/api/mt5
InpApiKey=apex_demo_key_99
InpScanIntervalSeconds=3
